# ---- required ----
# PostgreSQL 15+ with the pgvector extension (Supabase, Neon, RDS, or self-hosted).
DATABASE_URL=postgres://bawsala:bawsala@localhost:5432/bawsala_dev
# true when the database requires TLS (most managed providers)
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Public base URL (used in emails, sitemap, canonical URLs; https enables HSTS + upgrade-insecure-requests)
APP_URL=http://localhost:3000

# ---- AI (optional; without a key the product runs its deterministic "basic" engine) ----
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# per-task overrides — evaluate with `npm run eval:ai` before changing
# AI_MODEL_CHAT=
# AI_MODEL_EXTRACT=
AI_EFFORT=low
AI_DAILY_MESSAGES_PER_USER=60
# server-side refusal fallback (Claude API only)
AI_FALLBACKS=true

# ---- embeddings for RAG (default: local multilingual-e5-small; run `npm run models:fetch`) ----
EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_MODEL_DIR=./models/multilingual-e5-small
# EMBEDDINGS_PROVIDER=voyage
# VOYAGE_API_KEY=

# ---- email (optional; without a key, emails are not sent and are logged in development only) ----
RESEND_API_KEY=
EMAIL_FROM="BAWSALA <no-reply@example.com>"

# ---- operations ----
# Comma-separated emails that become platform admins when they sign up
ADMIN_EMAILS=
# Shared secret for POST /api/v1/cron/daily (scheduler → app)
CRON_SECRET=
# Seed demo (fictional) roles; set false in production once real opportunities exist
SEED_DEMO_OPPORTUNITIES=true
