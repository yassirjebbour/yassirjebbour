{
  "name": "bawsala",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "kb:ingest": "node --conditions=react-server --import tsx scripts/kb-ingest.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "eval:ai": "node --conditions=react-server --import tsx scripts/ai-eval.ts",
    "setup": "npm run db:migrate && npm run db:seed && npm run kb:ingest",
    "admin:grant": "tsx scripts/make-admin.ts",
    "rag:debug": "node --conditions=react-server --import tsx scripts/rag-debug.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^4.3.2",
    "mammoth": "^1.13.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
